# Copy to .env and adjust. .env is git-ignored — never commit real keys.
# All application settings use the FKL_ prefix. The LLM API key is the exception:
# it is read from the variable named by FKL_LLM_API_KEY_ENV (default below).

# --- LLM (needed from Phase 4 onward) ---------------------------------------
ANTHROPIC_API_KEY=
FKL_LLM_PROVIDER=anthropic
FKL_LLM_MODEL=claude-sonnet-5
FKL_LLM_API_KEY_ENV=ANTHROPIC_API_KEY
FKL_LLM_TEMPERATURE=0.0
FKL_LLM_MAX_TOKENS=4096
FKL_PROMPT_VERSION=v1

# --- storage --------------------------------------------------------------------
# FKL_DATABASE_PATH=./data/knowledge.db
# FKL_UPLOADS_DIR=./uploads

# --- embeddings (needed from Phase 7 onward) -------------------------------
FKL_EMBEDDING_PROVIDER=fastembed
FKL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
FKL_EMBEDDING_DIM=384

# --- retrieval: starting defaults; the Phase 10 eval harness tunes these ---
FKL_RETRIEVAL_TOP_K=15
FKL_RETRIEVAL_CANDIDATE_THRESHOLD=0.55
FKL_PREDICATE_SIMILARITY_THRESHOLD=0.60
FKL_RELATIONSHIP_CONFIDENCE_THRESHOLD=0.50
FKL_RETRIEVAL_WEIGHT_EMBEDDING=0.5
FKL_RETRIEVAL_WEIGHT_PREDICATE=0.3
FKL_RETRIEVAL_WEIGHT_BM25=0.2

# --- deterministic numeric comparison ---------------------------------------
FKL_NUMERIC_EQUIVALENCE_TOLERANCE=0.02
FKL_NUMERIC_CONTRADICTION_THRESHOLD=0.15

# --- ingestion limits / knobs -----------------------------------------------
FKL_MAX_UPLOAD_MB=25
FKL_MAX_PAGES=300
FKL_MAX_CHUNKS_PER_DOC=4000
FKL_MAX_LLM_CALLS_PER_DOC=800
FKL_FY_CONVENTION_DEFAULT=apr-mar

# page source-quality thresholds (Phase 2): 0 chars -> EMPTY;
# 0 < chars < FKL_OCR_MIN_CHARS, or density below the floor -> LOW_TEXT
FKL_OCR_MIN_CHARS=100
FKL_LOW_TEXT_DENSITY_PER_KCHAR2=0.35

# deterministic page-aware chunking (Phase 2) — later phases may retune
FKL_CHUNK_TARGET_CHARS=1200
FKL_CHUNK_OVERLAP_CHARS=150
FKL_CHUNK_BOUNDARY_BACKOFF_CHARS=200

# --- app ----------------------------------------------------------------------
FKL_APP_HOST=127.0.0.1
FKL_APP_PORT=8000
FKL_LOG_LEVEL=info
