# Copy to .env and adjust. .env is git-ignored — never commit real keys.
# All application settings use the FKL_ prefix. The LLM API key is the exception:
# it is read from the variable named by FKL_LLM_API_KEY_ENV (default below).

# --- LLM (needed from Phase 4 onward) ---------------------------------------
# The provider is Google Gemini. Put the key here or in the environment; a real
# environment variable wins over this file.
GEMINI_API_KEY=

# Optional — these are the defaults, uncomment only to change them:
# FKL_LLM_MODEL=gemini-2.5-flash
# FKL_LLM_API_KEY_ENV=GEMINI_API_KEY   # which variable holds the key
FKL_LLM_TEMPERATURE=0.0          # 0.0 keeps extraction repeatable
FKL_LLM_MAX_TOKENS=8192         # per-chunk extraction output cap
FKL_LLM_TIMEOUT_SECONDS=120
FKL_LLM_RETRY_ATTEMPTS=5        # SDK-level retry on 429 / 5xx
FKL_PROMPT_VERSION=v2           # app/prompts/extraction_<v>.md (v1 kept for reproducibility)
FKL_RELATIONSHIP_PROMPT_VERSION=v1   # app/prompts/relationship_<v>.md (Phase 9)

# --- storage --------------------------------------------------------------------
# FKL_DATABASE_PATH=./data/knowledge.db
# FKL_UPLOADS_DIR=./uploads

# --- embeddings: RESERVED. The embedding retrieval rung was designed but
# deferred (no local model shipped); retrieval is deterministic + lexical.
# These are read but unused. See docs/RISKS.md.
FKL_EMBEDDING_PROVIDER=fastembed
FKL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
FKL_EMBEDDING_DIM=384

# --- entity resolution (Phase 7). The suffix/honorific/anaphora/rename lists
# are language-generic code defaults (see app/config.py) and rarely need an
# override; the two fuzzy thresholds and the prompt version are the tunables.
FKL_ENTITY_PROMPT_VERSION=v1          # app/prompts/entity_confirm_<v>.md
FKL_ENTITY_BLOCK_FUZZY_THRESHOLD=88   # rapidfuzz token_set_ratio: high-recall block gate
FKL_ENTITY_MERGE_FUZZY_THRESHOLD=94   # rapidfuzz token_sort_ratio: no-LLM auto-merge gate
# (a bare name vs "<name> Robotics" scores ~67 on token_sort_ratio, so it never
#  auto-merges — the gap between the two is where a confirm_entities call decides)

# --- retrieval: starting defaults; the Phase 10 eval harness tunes these ---
FKL_RETRIEVAL_TOP_K=15
FKL_RETRIEVAL_CANDIDATE_THRESHOLD=0.55
FKL_PREDICATE_SIMILARITY_THRESHOLD=0.60
FKL_RELATIONSHIP_CONFIDENCE_THRESHOLD=0.50
# WEIGHT_EMBEDDING is reserved — the embedding retrieval rung is deferred
# (no local embedding model in this environment); Phase 8 ships lexical retrieval.
FKL_RETRIEVAL_WEIGHT_EMBEDDING=0.5
FKL_RETRIEVAL_WEIGHT_PREDICATE=0.3
FKL_RETRIEVAL_WEIGHT_BM25=0.2
FKL_RETRIEVAL_WEIGHT_ENTITY=0.4
FKL_RETRIEVAL_MIN_SHARED_TOKENS=2
FKL_RETRIEVAL_BUCKET_MAX=400

# --- deterministic numeric comparison ---------------------------------------
FKL_NUMERIC_EQUIVALENCE_TOLERANCE=0.02
FKL_NUMERIC_CONTRADICTION_THRESHOLD=0.15

# --- ingestion limits / knobs -----------------------------------------------
FKL_MAX_UPLOAD_MB=25
FKL_MAX_PAGES=300
FKL_MAX_CHUNKS_PER_DOC=4000
FKL_MAX_LLM_CALLS_PER_DOC=800
FKL_FY_CONVENTION_DEFAULT=apr-mar

# page source-quality thresholds (Phase 2): 0 chars -> EMPTY;
# 0 < chars < FKL_OCR_MIN_CHARS, or density below the floor -> LOW_TEXT
FKL_OCR_MIN_CHARS=100
FKL_LOW_TEXT_DENSITY_PER_KCHAR2=0.35

# deterministic page-aware chunking (Phase 2) — later phases may retune
FKL_CHUNK_TARGET_CHARS=1200
FKL_CHUNK_OVERLAP_CHARS=150
FKL_CHUNK_BOUNDARY_BACKOFF_CHARS=200

# evidence verification (Phase 5) — fuzzy is a last resort behind a numeric/unit guard
FKL_VERIFY_FUZZY_THRESHOLD=90.0
FKL_VERIFY_FUZZY_MIN_QUOTE_CHARS=12
FKL_VERIFY_NUMERIC_TOLERANCE=1e-6

# --- app ----------------------------------------------------------------------
FKL_APP_HOST=127.0.0.1
FKL_APP_PORT=8000
FKL_LOG_LEVEL=info
